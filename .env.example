# ============ 树仁学发 · 学习搭子匹配系统 配置 ============
# 复制为 .env 后按需修改

# 服务端口与对外访问地址（用于邮件中的链接、Cookie 安全策略）
PORT=8787
APP_URL=http://localhost:5173

# 首次激活填写 8 位数字学号，验证码发往 <学号>@mail.sustech.edu.cn。
# 验证后自设密码，之后使用完整邮箱 + 密码登录；忘记密码使用邮箱验证码重置。

# 管理员邮箱（逗号分隔）。这些邮箱完成首次登录后自动获得管理员权限
ADMIN_EMAILS=

# 优先使用 Resend API，MAIL_FROM 必须为 Resend 已验证域名下的发件地址。
RESEND_API_KEY=
MAIL_FROM=no-reply@your-verified-domain.example
# 未配置 API 时可沿用以下 Resend SMTP（587，强制 STARTTLS）。
# 两者都未配置：生产验证码不可用；本地开发可显示验证码。
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
# STARTTLS（例如 Resend 587）时设 SMTP_SECURE=false、SMTP_REQUIRE_TLS=true
SMTP_REQUIRE_TLS=true
SMTP_USER=resend
SMTP_PASS=

# 数据目录（SQLite 数据库与上传图片），默认 ./data
DATA_DIR=data
# 登录有效期（天）
SESSION_DAYS=30
